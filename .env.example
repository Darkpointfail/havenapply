# HavenApply environment template
# Copy to `.env.local`. Never commit real secrets.

# Auth backend: use "supabase" in staging/production.
NEXT_PUBLIC_DATA_BACKEND=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Force open-access demo off in production (also blocked by NODE_ENV=production).
NEXT_PUBLIC_AUTH_OPEN_ACCESS=false

# Only for non-production seeding. Must be unset/false in production.
AUTH_SIGNUP_AUTO_CONFIRM=

# HMAC secret for auth / access event identifier hashing
ACCESS_LOG_HASH_SECRET=
AUTH_EVENT_HASH_SECRET=

# Site gate
SITE_ACCESS_PASSWORD=

# Optional CSRF test bypass header value (never in production browsers)
CSRF_TEST_BYPASS=
