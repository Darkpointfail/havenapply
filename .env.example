# HavenApply environment template
# Copy to `.env.local` and fill in values. Never commit real secrets.

# --- Site access gate ---
# Overrides the code default when set.
SITE_ACCESS_PASSWORD=

# HMAC-SHA256 secret used to fingerprint client IPs in access logs (server-only).
# Generate with: openssl rand -hex 32
ACCESS_LOG_HASH_SECRET=

# Bearer token required to read / export site access logs when not using an internal Supabase session.
# Generate with: openssl rand -hex 32
ACCESS_LOGS_ADMIN_TOKEN=

# --- Supabase (optional; enables DB-backed logs + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_DATA_BACKEND=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_AUTH_OPEN_ACCESS=false
