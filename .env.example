# Copy to `.env` for local development. No production secrets here.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# Database (Docker Compose postgres)
DATABASE_URL=postgresql://haven:haven@localhost:5432/havenapply?schema=public

# Auth.js
AUTH_TRUST_HOST=true

# Object storage — local MinIO (S3-compatible). Production: set STORAGE_DRIVER=s3 and real credentials.
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=haven-private
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Email — local Mailpit (SMTP). Production: set EMAIL_DRIVER=resend and RESEND_API_KEY.
EMAIL_DRIVER=smtp
EMAIL_FROM="HavenApply <noreply@havenapply.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# RESEND_API_KEY=

# Optional: force locale default
DEFAULT_LOCALE=fr

# Documents — private object storage constraints
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_ALLOWED_MIME=application/pdf,image/jpeg,image/png
DOCUMENT_SIGNED_URL_TTL_SECONDS=60
DOCUMENT_PURGE_DELAY_DAYS=30
# Optional ClamAV (clamd). When unset, uploads use an explicit dev passthrough — NOT a real virus scan.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# Invitations — token lifetime and accept rate limit (security emails always sent; prefs do not apply).
INVITATION_TTL_HOURS=168
INVITATION_ATTEMPT_LIMIT=20
