# HavenApply — environment variables (values not included)

# Data backend: "local" (default, server .data/ store) or "supabase"
NEXT_PUBLIC_DATA_BACKEND=local

# Required when NEXT_PUBLIC_DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin (auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs httpOnly family session cookies in local backend mode
HAVEN_SESSION_SECRET=

# Optional: open-access demo portals (keep false in production)
NEXT_PUBLIC_AUTH_OPEN_ACCESS=false

# Transactional email (password reset, email verification, ...). Without
# these, emails are only logged to the server console — nothing is sent.
# Get RESEND_API_KEY from https://resend.com after verifying a sending
# domain there; EMAIL_FROM must be an address on that verified domain.
RESEND_API_KEY=
EMAIL_FROM=
