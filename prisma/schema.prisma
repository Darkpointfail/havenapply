generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAMILY
  STAFF
  ADMIN
}

enum CaregiverRole {
  OWNER
  EDITOR
  VIEWER
}

enum StaffPermission {
  VIEW_APPLICATIONS
  MANAGE_APPLICATIONS
  MANAGE_DOCUMENTS
  MANAGE_STAFF
  MANAGE_ORG
}

/// Facility-side membership role (distinct from CaregiverRole on family profiles).
enum StaffOrgRole {
  OWNER
  EDITOR
  VIEWER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_DOCUMENTS
  WAITLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum DocumentStatus {
  UPLOADING
  AVAILABLE
  QUARANTINED
  DELETED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Auth.js-compatible user. Global role is coarse; staff site access uses StaffMembership.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(FAMILY)
  isDevAccount  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  authTokens             AuthToken[]
  ownedFamilies          FamilyProfile[]          @relation("FamilyOwner")
  caregiverMemberships   CaregiverMembership[]
  staffMemberships       StaffMembership[]
  staffInvitationsSent   StaffInvitation[]        @relation("InvitationInviter")
  uploadedDocuments      Document[]               @relation("DocumentUploader")
  statusChanges          ApplicationStatusHistory[] @relation("StatusChanger")
  auditEvents            AuditEvent[]
  notificationPreference NotificationPreference?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Revocable database sessions. Cookie holds raw token; DB stores SHA-256 hash.
model Session {
  id               String    @id @default(cuid())
  sessionToken     String    @unique
  sessionTokenHash String    @unique
  userId           String
  expires          DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  ipAddress        String?
  userAgent        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

/// Legacy Auth.js verification table (kept for adapter compatibility).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time auth tokens (email verify / password reset). Only hashes are stored.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String?
  email     String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

model FamilyProfile {
  id          String   @id @default(cuid())
  ownerUserId String
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User                  @relation("FamilyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberships  CaregiverMembership[]
  applications Application[]
  documents    Document[]

  @@index([ownerUserId])
}

model CaregiverMembership {
  id              String        @id @default(cuid())
  familyProfileId String
  userId          String
  role            CaregiverRole @default(VIEWER)
  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())

  family FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyProfileId, userId])
  @@index([userId])
}

model ResidenceOrganization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  isActive   Boolean  @default(true)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sites        ResidenceSite[]
  memberships  StaffMembership[]
  invitations  StaffInvitation[]
}

model ResidenceSite {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  city           String?
  isActive       Boolean  @default(true)
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization ResidenceOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  StaffMembership[]
  invitations  StaffInvitation[]
  applications Application[]

  @@index([organizationId])
}

model StaffMembership {
  id             String      @id @default(cuid())
  userId         String
  organizationId String
  /// Null = organization-wide access to all sites.
  siteId         String?
  /// OWNER/EDITOR may mutate admissions; VIEWER is read-only.
  orgRole        StaffOrgRole @default(EDITOR)
  createdAt      DateTime    @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization ResidenceOrganization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         ResidenceSite?         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  permissions  StaffMembershipPermission[]

  @@unique([userId, organizationId, siteId])
  @@index([userId])
  @@index([organizationId])
  @@index([siteId])
}

model StaffMembershipPermission {
  membershipId String
  permission   StaffPermission

  membership StaffMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, permission])
}

model StaffInvitation {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String?
  email          String
  tokenHash      String   @unique
  invitedByUserId String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization ResidenceOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         ResidenceSite?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  invitedBy    User                  @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  permissions  StaffInvitationPermission[]

  @@index([email])
  @@index([organizationId])
}

model StaffInvitationPermission {
  invitationId String
  permission   StaffPermission

  invitation StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@id([invitationId, permission])
}

/// Family → site admission application.
/// Payload is intentionally minimized (identity/contact/consents only — no medical narrative).
model Application {
  id              String            @id @default(cuid())
  familyProfileId String
  siteId          String
  status          ApplicationStatus @default(DRAFT)
  /// Human-readable, non-guessable reference (e.g. HA-7K3MQ9WP). Assigned at draft creation.
  publicRef       String            @unique
  submittedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  /// Preferred name of the person seeking residence (not a full legal dossier).
  residentPreferredName String?
  /// Birth year only — avoids storing a full date of birth until necessary.
  residentBirthYear     Int?
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  /// Preferred move window as YYYY-MM (optional).
  preferredMoveMonth    String?
  /// Short operational note only — never medical content. Max enforced in validation.
  urgencyNote           String?
  consentPrivacy        Boolean  @default(false)
  consentShareWithSite  Boolean  @default(false)
  consentAt             DateTime?
  /// Wizard step 1..4 for draft UX (site → resident → contact → review).
  draftStep             Int      @default(1)
  /// Client-provided key making submit idempotent across retries.
  submitIdempotencyKey  String?  @unique
  /// Optimistic concurrency token for status transitions.
  version               Int      @default(1)

  family        FamilyProfile              @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  site          ResidenceSite              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  statusHistory ApplicationStatusHistory[]
  documents     Document[]

  @@index([familyProfileId])
  @@index([siteId])
  @@index([status])
}

model ApplicationStatusHistory {
  id              String             @id @default(cuid())
  applicationId   String
  fromStatus      ApplicationStatus?
  toStatus        ApplicationStatus
  changedByUserId String?
  /// Legacy short note (kept for older rows). Prefer internalNote / familyMessage.
  note            String?
  /// Staff-only — never shown to family.
  internalNote    String?
  /// Message safe to show the family (and optionally email).
  familyMessage   String?
  /// Structured document checklist when toStatus = NEEDS_DOCUMENTS.
  requestedDocuments Json?
  waitlistPosition Int?
  /// Acceptance next steps shown to family.
  nextSteps       String?
  /// True when reopening ACCEPTED/REJECTED → UNDER_REVIEW.
  isReopen        Boolean            @default(false)
  /// Client idempotency key for this transition (unique when set).
  idempotencyKey  String?            @unique
  createdAt       DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("StatusChanger", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
}

/// Transactional outbox for emails/notifications. Payload must never include secrets or documents.
model OutboxEvent {
  id             String       @id @default(cuid())
  type           String
  aggregateType  String
  aggregateId    String
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

/// Private application document. Object key is opaque and never client-controlled.
/// Soft-delete sets status=DELETED + deletedAt; object purge is deferred (purgeAfter).
model Document {
  id               String         @id @default(cuid())
  familyProfileId  String
  applicationId    String?
  /// Opaque server-generated object key (never derived from user filename).
  storageKey       String         @unique
  /// Sanitized original filename for display only.
  originalFileName String
  contentType      String
  sizeBytes        Int
  checksumSha256   String?
  status           DocumentStatus @default(UPLOADING)
  /// Scanner used: "clamav" | "dev-passthrough" — never claim real AV if passthrough.
  scanAdapter      String?
  /// clean | infected | skipped_dev | error
  scanResult       String?
  scannedAt        DateTime?
  deletedAt        DateTime?
  /// Earliest time the object may be hard-purged from storage after soft-delete.
  purgeAfter       DateTime?
  uploadedByUserId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  family      FamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  application Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  uploadedBy  User          @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([familyProfileId])
  @@index([applicationId])
  @@index([status])
  @@index([purgeAfter])
}

/// Security / ops audit trail. Never store secrets or medical content in metadata.
model AuditEvent {
  id         String   @id @default(cuid())
  actorUserId String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  emailEnabled        Boolean @default(true)
  applicationUpdates  Boolean @default(true)
  documentUpdates     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
