# HavenApply environment template
# Copy to .env.local (development), CI secrets (test), or Vercel / secrets manager (production).
# NEVER commit real values. Use different values per environment (HAVEN_ENV).

# development | test | production
HAVEN_ENV=development

# Public site URL (must be https:// in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data backend: local (demo) | supabase (production)
NEXT_PUBLIC_DATA_BACKEND=local

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; secrets manager) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Site gate (server-only) ---
# Required in production. When unset in development, the gate is disabled.
SITE_ACCESS_PASSWORD=
SITE_ACCESS_SIGNING_SECRET=
# Optional grace secret during rotation
SITE_ACCESS_SIGNING_SECRET_PREVIOUS=

# --- Document download grants (server-only) ---
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_SIGNING_SECRET_PREVIOUS=

# --- Analytics (public measurement id, not a confidential secret) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Maps (browser key; restrict by HTTP referrer in Google Cloud) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Emergency only — never set in real production
# ALLOW_INSECURE_HTTP=1
