# Copy to `.env` for local development. No production secrets here.

# App
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=dev-only-change-me-to-a-long-random-string

# Database (Docker Compose postgres)
DATABASE_URL=postgresql://haven:haven@localhost:5432/havenapply?schema=public

# Auth.js
AUTH_TRUST_HOST=true

# Object storage — local MinIO (S3-compatible). Production: set STORAGE_DRIVER=s3 and real credentials.
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=haven-private
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Email — local Mailpit (SMTP). Production: set EMAIL_DRIVER=resend and RESEND_API_KEY.
EMAIL_DRIVER=smtp
EMAIL_FROM="HavenApply <noreply@havenapply.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# RESEND_API_KEY=

# Optional: force locale default
DEFAULT_LOCALE=fr
