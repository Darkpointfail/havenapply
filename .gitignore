# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# private document blobs (PHI) — never commit
/data/private-documents/**
!/data/private-documents/.gitkeep
!/data/private-documents/README.md
!/data/private-documents/.gitignore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
